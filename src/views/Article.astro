---
/**
 * Kontent maqolasi uchun umumiy shablon.
 * taqqoslash / xavfsizlik / qollanma — uchalasi shuni ishlatadi.
 */
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BuyCta from '../components/BuyCta.astro';
import { t, type Locale } from '../i18n/ui';
import { SECTIONS, PRODUCTS, type SectionKey } from '../i18n/pages';
import { localePath } from '../config/site.js';
import { articleNode, breadcrumbNode, faqNode, howToNode } from '../lib/schema';

interface Props {
  locale: Locale;
  section: SectionKey;
  entry: any;
}
const { locale, section, entry } = Astro.props;
const tr = t(locale);

const d = entry.data;
const slug = entry.id.split('/').slice(1).join('/');
const path = `/${section}/${slug}`;
const SOURCE = `${section}-${slug}`;

const { Content } = await render(entry);

/**
 * Maqola oxiridagi ichki havolalar.
 *
 * Maqola sahifasi saytdagi eng chekka nuqta — u yerdan bosh sahifaga va
 * mahsulot ustuniga yo'l bo'lmasa, ham o'quvchi, ham crawler shu yerda
 * to'xtaydi. Havola matni tavsiflovchi bo'lishi shart: "bu yerda" emas,
 * sahifaning o'zi nima haqidaligi.
 */
const PRODUCT_SLUG = {
  stars: 'telegram-stars',
  premium: 'telegram-premium',
  gifts: 'telegram-gifts',
} as const;

const pillarSlug = PRODUCT_SLUG[d.product as keyof typeof PRODUCT_SLUG];
const pillarName = PRODUCTS[locale][pillarSlug].name;

const relatedTitle = {
  uz: 'Davom ettiring',
  ru: 'Продолжить',
  en: 'Continue',
}[locale];

const related = [
  {
    href: localePath('/', locale),
    label: {
      uz: 'Barcha narxlar va xizmatlar reytingi — bosh sahifa',
      ru: 'Все цены и рейтинг сервисов — главная страница',
      en: 'All prices and service rankings — home page',
    }[locale],
  },
  {
    href: localePath(`/${pillarSlug}`, locale),
    label: {
      uz: `${pillarName} — narxlar va xarid yo‘llari`,
      ru: `${pillarName} — цены и способы покупки`,
      en: `${pillarName} — prices and buying routes`,
    }[locale],
  },
  {
    href: localePath('/narxlar', locale),
    label: {
      uz: 'Barcha xizmatlarning e’lon qilingan narxlari',
      ru: 'Опубликованные цены всех сервисов',
      en: 'Published prices from every service',
    }[locale],
  },
  ...(d.product === 'gifts' ? [] : [{
    href: localePath(`/reyting/${pillarSlug}`, locale),
    label: {
      uz: `${pillarName} xizmatlari reytingi — ochiq mezonlar bo‘yicha`,
      ru: `Рейтинг сервисов ${pillarName} — по открытым критериям`,
      en: `${pillarName} service ranking — on published criteria`,
    }[locale],
  }]),
  {
    href: localePath(`/${section}`, locale),
    label: SECTIONS[locale][section].h1,
  },
];

const schema = [
  breadcrumbNode(locale, [
    { name: 'Infogram', path: '/' },
    { name: SECTIONS[locale][section].h1, path: `/${section}` },
    { name: d.title, path },
  ]),
  articleNode({
    locale,
    headline: d.title,
    description: d.description,
    path,
    datePublished: d.published,
    dateModified: d.updated,
  }),
  ...(d.faq.length ? [faqNode(d.faq)] : []),
  ...(d.steps.length ? [howToNode({ name: d.title, steps: d.steps })] : []),
];
---

<Layout
  {locale}
  title={d.metaTitle ?? `${d.title} | Infogram`}
  description={d.description}
  {path}
  {schema}
  ogType="article"
  articleDates={{ published: d.published, modified: d.updated }}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={localePath('/', locale)}>Infogram</a>
    <span aria-hidden="true">/</span>
    <a href={localePath(`/${section}`, locale)}>{SECTIONS[locale][section].h1}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{d.title}</span>
  </nav>

  <h1>{d.title}</h1>

  <div class="answer">
    <p><strong>{locale === 'uz' ? 'Qisqa javob.' : locale === 'ru' ? 'Коротко.' : 'Short answer.'}</strong> {d.answer}</p>
    <p class="meta">
      {tr('label.updated')}: <time datetime={d.updated}>{d.updated}</time>
    </p>

    {/* Xarid yo'li javob QUTISI ICHIDA. O'quvchi javobni shu yerda oladi —
        tugma quti tashqarisida yoki sahifa oxirida bo'lsa, ko'pchilik uni
        ko'rmaydi. `-top` qo'shimchasi voronkada yuqori va quyi CTA'ni ajratadi. */}
    <BuyCta {locale} product={d.product} source={`${SOURCE}-top`} compact />
  </div>

  <article class="prose">
    <Content />
  </article>

  <BuyCta {locale} product={d.product} source={`${SOURCE}-cta`} />

  {d.faq.length > 0 && (
    <>
      <h2>
        {locale === 'uz' && 'Tez-tez beriladigan savollar'}
        {locale === 'ru' && 'Частые вопросы'}
        {locale === 'en' && 'Frequently asked questions'}
      </h2>
      {d.faq.map((item: any) => (<><h3>{item.q}</h3><p>{item.a}</p></>))}
    </>
  )}

  <section aria-labelledby="related-heading">
    <h2 id="related-heading">{relatedTitle}</h2>
    <ul class="related">
      {related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
    </ul>
  </section>
</Layout>
