---
/**
 * JSON-LD stacking. GEO uchun asosiy qatlam — LLM'lar sahifadan faktni
 * shu yerdan tortadi.
 *
 * Har sahifada kamida: WebSite/Organization (Layout'dan) + shu yerdagi
 * kontentga mos tur(lar). Bir nechta turni bitta @graph ga yig'amiz —
 * alohida <script> teglariga bo'lishdan ko'ra ishonchliroq o'qiladi.
 */
import { HREFLANG } from '../config/site.js';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Tayyor JSON-LD node'lari. @context avtomatik qo'shiladi. */
  nodes: Record<string, unknown>[];
}

const { locale, nodes } = Astro.props;

/**
 * `inLanguage` — CreativeWork xususiyati. Organization, BreadcrumbList,
 * ItemList va Product uni qo'llab-quvvatlamaydi; hammasiga qo'shib yuborish
 * validatorlarda ogohlantirish beradi, shuning uchun ro'yxat aniq.
 */
const LOCALIZABLE = new Set([
  'WebSite', 'WebPage', 'CollectionPage', 'Article', 'FAQPage', 'HowTo', 'Dataset',
]);

const graph = nodes.map((n) =>
  LOCALIZABLE.has(n['@type'] as string) ? { inLanguage: HREFLANG[locale], ...n } : n,
);

const payload = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(payload)}
/>
