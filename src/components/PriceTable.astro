---
/**
 * Narx jadvali — providers.json dan render qilinadi.
 * Eng past narx `.best` bilan belgilanadi, qaysi provayder bo'lishidan qat'i nazar.
 */
import {
  sellersOf, starsPerUnit, starsPrice, isStarsPriceExact,
  premiumPrice, uzs, type ProductId,
} from '../lib/providers';
import { t, type Locale } from '../i18n/ui';
import ProviderLink from './ProviderLink.astro';

interface Props {
  locale: Locale;
  product: Extract<ProductId, 'stars' | 'premium'>;
  /** Stars uchun ustun sifatida ko'rsatiladigan miqdorlar. */
  quantities?: number[];
  /** Premium uchun ustun sifatida ko'rsatiladigan oylar. */
  months?: number[];
  source: string;
  caption?: string;
}

const {
  locale, product, source, caption,
  quantities = [50, 100, 500, 1000],
  months = [1, 3, 6, 12],
} = Astro.props;

const tr = t(locale);
const sellers = sellersOf(product);

// Har ustun bo'yicha eng arzonini oldindan aniqlaymiz.
const cols = product === 'stars' ? quantities : months;
const bestByCol = new Map<number, number>();
for (const col of cols) {
  // Faqat E'LON QILINGAN narx "eng arzon" bo'la oladi — biz hisoblagan
  // taxminiy qiymat rasman e'lon qilingan narx bilan teng raqobatlashmaydi.
  const values = sellers
    .filter((p) => (product === 'stars' ? isStarsPriceExact(p, col) : true))
    .map((p) => (product === 'stars' ? starsPrice(p, col) : premiumPrice(p, col)))
    .filter((v): v is number => v !== null);
  if (values.length) bestByCol.set(col, Math.min(...values));
}

const hasApprox = product === 'stars'
  && sellers.some((p) => quantities.some((q) => starsPrice(p, q) !== null && !isStarsPriceExact(p, q)));
---

<div class="table-scroll">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">{tr('label.provider')}</th>
        {product === 'stars' && <th scope="col" class="num">{tr('label.perStar')}</th>}
        {cols.map((c) => (
          <th scope="col" class="num">
            {product === 'stars' ? `${c} ⭐` : `${c} ${tr('label.months')}`}
          </th>
        ))}
        <th scope="col">{tr('label.delivery')}</th>
      </tr>
    </thead>
    <tbody>
      {sellers.map((p) => (
        <tr>
          <th scope="row"><ProviderLink provider={p} source={source} /></th>

          {product === 'stars' && (
            <td class="num">
              {starsPerUnit(p) === null ? '—' : `${uzs(starsPerUnit(p))}`}
            </td>
          )}

          {cols.map((c) => {
            const value = product === 'stars' ? starsPrice(p, c) : premiumPrice(p, c);
            const exact = product === 'stars' ? isStarsPriceExact(p, c) : true;
            const isBest = value !== null && value === bestByCol.get(c);
            return (
              <td class="num">
                {value === null ? (
                  <span class="approx">{tr('label.notPublished')}</span>
                ) : (
                  <>
                    <span class={isBest ? 'best' : undefined}>{uzs(value)}</span>
                    {!exact && <span class="approx"> *</span>}
                  </>
                )}
              </td>
            );
          })}

          <td class="meta">{p.deliveryMinutes.claim}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

{hasApprox && <p class="note">* {tr('note.approx')}</p>}
