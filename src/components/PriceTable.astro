---
/**
 * Narx jadvali — providers.json dan render qilinadi.
 * Eng past narx `.best` bilan belgilanadi, qaysi provayder bo'lishidan qat'i nazar.
 */
import {
  sellersOf, starsPerUnit, starsPrice, isStarsPriceListed, isStarsPricePublished,
  premiumPrice, deliveryClaim, uzs, type ProductId,
} from '../lib/providers';
import { t, type Locale } from '../i18n/ui';
import ProviderLink from './ProviderLink.astro';
import { SOURCES, VERIFIED_AT } from '../lib/providers';

interface Props {
  locale: Locale;
  product: Extract<ProductId, 'stars' | 'premium'>;
  /** Stars uchun ustun sifatida ko'rsatiladigan miqdorlar. */
  quantities?: number[];
  /** Premium uchun ustun sifatida ko'rsatiladigan oylar. */
  months?: number[];
  caption?: string;
}

const {
  locale, product, caption,
  quantities = [50, 100, 500, 1000],
  months = [1, 3, 6, 12],
} = Astro.props;

const tr = t(locale);
const sellers = sellersOf(product);

// Har ustun bo'yicha eng arzonini oldindan aniqlaymiz.
const cols = product === 'stars' ? quantities : months;
const bestByCol = new Map<number, number>();
for (const col of cols) {
  // Ochiq ma'lumotdan kelib chiqadigan har qanday narx qatnashadi: paket ham,
  // e'lon qilingan flat rate'dan chiqqan narx ham. Aks holda paket e'lon
  // qilmagan arzonroq provayder taqqoslashdan tushib qolardi.
  const values = sellers
    .filter((p) => (product === 'stars' ? isStarsPricePublished(p, col) : true))
    .map((p) => (product === 'stars' ? starsPrice(p, col) : premiumPrice(p, col)))
    .filter((v): v is number => v !== null);
  if (values.length) bestByCol.set(col, Math.min(...values));
}

// `*` belgisi: narx tayyor paket sifatida emas, e'lon qilingan
// 1 dona narxidan ko'paytirib chiqarilgan.
const hasComputed = product === 'stars'
  && sellers.some((p) => quantities.some((q) => starsPrice(p, q) !== null && !isStarsPriceListed(p, q)));
---

<div class="table-scroll">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">{tr('label.provider')}</th>
        {product === 'stars' && <th scope="col" class="num">{tr('label.perStar')}</th>}
        {cols.map((c) => (
          <th scope="col" class="num">
            {product === 'stars' ? `${c} ⭐` : `${c} ${tr('label.months')}`}
          </th>
        ))}
        <th scope="col">{tr('label.delivery')}</th>
      </tr>
    </thead>
    <tbody>
      {sellers.map((p) => (
        <tr>
          <th scope="row"><ProviderLink provider={p} /></th>

          {product === 'stars' && (
            <td class="num">
              {starsPerUnit(p) === null ? '—' : `${uzs(starsPerUnit(p))}`}
            </td>
          )}

          {cols.map((c) => {
            const value = product === 'stars' ? starsPrice(p, c) : premiumPrice(p, c);
            const listed = product === 'stars' ? isStarsPriceListed(p, c) : true;
            const isBest = value !== null && value === bestByCol.get(c);
            return (
              <td class="num">
                {value === null ? (
                  <span class="approx">{tr('label.notPublished')}</span>
                ) : (
                  <>
                    <span class={isBest ? 'best' : undefined}>{uzs(value)}</span>
                    {!listed && <span class="approx"> *</span>}
                  </>
                )}
              </td>
            );
          })}

          <td class="meta">{deliveryClaim(p, locale)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

{hasComputed && <p class="note">* {tr('note.approx')}</p>}

<p class="source-note">
  {locale === 'uz' && <>Manbalar va tekshiruv: <time datetime={VERIFIED_AT}>{VERIFIED_AT}</time>. </>}
  {locale === 'ru' && <>Источники и проверка: <time datetime={VERIFIED_AT}>{VERIFIED_AT}</time>. </>}
  {locale === 'en' && <>Sources and verification: <time datetime={VERIFIED_AT}>{VERIFIED_AT}</time>. </>}
  {sellers.map((p, i) => (
    <>{i > 0 && ' · '}<a href={((SOURCES as any)[p.id] ?? [p.site])[0]} rel="noopener nofollow" target="_blank">{p.name}</a></>
  ))}
</p>
