---
/**
 * Brend belgisi — bir-biriga yaqin ikki nuqta va ularni bog'laydigan shakl.
 * Narxlar orasidagi aniq aloqani bildiradi; navigatsiya ikonkasiga
 * o'xshamasligi uchun gorizontal chiziqlar ishlatilmaydi.
 */
import type { Locale } from '../i18n/ui';

interface Props { href: string; locale: Locale }
const { href, locale } = Astro.props;
const label = {
  uz: 'Infogram — bosh sahifa',
  ru: 'Infogram — главная страница',
  en: 'Infogram — home page',
}[locale];
---

<a class="brand" href={href} aria-label={label}>
  <svg class="mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <rect x="4" y="3" width="16" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2.2" />
    <path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="wordmark">infogram<span class="tld">.uz</span></span>
</a>
