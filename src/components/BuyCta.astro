---
/**
 * Xarid CTA.
 *
 * Muhim: tugma matni HARAKATNI aytadi ("Stars sotib olish"), brendni emas.
 * Tashrif buyuruvchining niyati "bot ochish" emas — u mahsulot olmoqchi.
 * Brend nomi ostida kichik izoh sifatida qoladi: kim orqali ketayotgani
 * yashirilmaydi, lekin qarorni to'sib ham qo'ymaydi.
 */
import { t, type Locale } from '../i18n/ui';
import { botLink } from '../config/site.js';
import { PRIMARY, providerName, sellersOf } from '../lib/providers';

interface Props {
  locale: Locale;
  product: 'stars' | 'premium' | 'gifts';
  /** Atributsiya uchun manba identifikatori. */
  source: string;
  /** Ikkinchi darajali havola (masalan, narxlarga). */
  secondary?: { href: string; label: string };
  /** Blok sarlavhasi. Bir sahifada bir nechta CTA bo'lsa, qaysi mahsulot
   *  ekanini ajratish uchun (masalan narxlar sahifasida Stars va Premium). */
  title?: string;
  /**
   * Ixcham shakl — faqat tugmalar qatori.
   *
   * Qisqa javob ostiga qo'yish uchun: o'quvchi javobni o'qib bo'lgan joyda
   * xarid yo'li ko'rinishi kerak, lekin to'liq blok (sarlavha + bot nomlari +
   * izoh) u yerda kontentni pastga surib yuboradi. Bot nomlari va oshkoralik
   * matni sahifa oxiridagi to'liq blokda saqlanib qoladi.
   */
  compact?: boolean;
}

const { locale, product, source, secondary, title, compact = false } = Astro.props;
const tr = t(locale);

const label = {
  stars: tr('cta.buyStars'),
  premium: tr('cta.buyPremium'),
  gifts: tr('cta.sendGift'),
}[product];

/**
 * SHU MAHSULOTNI sotadigan barcha botli xizmatlar CTA oladi — bittasi ham
 * tashlab ketilmaydi. Ro'yxat providers.json dan chiqadi, ya'ni PremiumSend
 * Premium sahifalarida o'zi paydo bo'ladi va Stars sahifalarida o'zi
 * chiqmaydi (u Stars sotmaydi — qo'shsak yolg'on bo'lardi).
 *
 * Asosiy xizmat (PRIMARY) birinchi turadi va yagona `btn-primary` bo'ladi.
 */
const routes = (() => {
  const withBot = sellersOf(product).filter((p) => p.bot);
  return [
    ...withBot.filter((p) => p.id === PRIMARY.id),
    ...withBot.filter((p) => p.id !== PRIMARY.id),
  ];
})();

/** Atributsiya kaliti. PRIMARY uchun qo'shimchasiz — mavjud analitika uzilmaydi. */
const sourceFor = (id: string) => (id === PRIMARY.id ? source : `${source}-${id}`);

const optionsTitle = title ?? {
  uz: 'Xarid variantlari',
  ru: 'Варианты покупки',
  en: 'Purchase options',
}[locale];
---

<div class={compact ? 'cta-block cta-compact' : 'cta-block'}>
  {!compact && <p class="cta-options-title"><strong>{optionsTitle}</strong></p>}
  <div class="hero-cta">
    {routes.map((p) => (
      <a
        class={`btn ${p.id === PRIMARY.id ? 'btn-primary' : 'btn-ghost'}`}
        href={botLink(p.bot!, sourceFor(p.id))}
        target="_blank"
        rel="noopener sponsored nofollow"
        data-funnel-event
        data-source={sourceFor(p.id)}
        data-product={product}
        data-provider={p.id}
      >
        {label}
        <span class="btn-provider">— {providerName(p, locale)}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
    {secondary && <a class="link-cta" href={secondary.href}>{secondary.label}</a>}
  </div>
  {!compact && (
    <>
      <p class="cta-note">
        {routes.map((p, i) => (
          <>{i > 0 && ' · '}<strong>{providerName(p, locale)}</strong> — @{p.bot}</>
        ))}
      </p>
      <p class="cta-disclosure">
        {locale === 'uz' && 'Xarid tanlangan xizmatning Telegram botida amalga oshiriladi.'}
        {locale === 'ru' && 'Покупка оформляется в Telegram-боте выбранного сервиса.'}
        {locale === 'en' && 'The purchase is completed in the selected service’s Telegram bot.'}
      </p>
    </>
  )}
</div>
