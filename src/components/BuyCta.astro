---
/**
 * Xarid CTA.
 *
 * Muhim: tugma matni HARAKATNI aytadi ("Stars sotib olish"), brendni emas.
 * Tashrif buyuruvchining niyati "bot ochish" emas — u mahsulot olmoqchi.
 * Brend nomi ostida kichik izoh sifatida qoladi: kim orqali ketayotgani
 * yashirilmaydi, lekin qarorni to'sib ham qo'ymaydi.
 */
import { t, type Locale } from '../i18n/ui';
import { botLink } from '../config/site.js';
import { PRIMARY, sellersOf } from '../lib/providers';

interface Props {
  locale: Locale;
  product: 'stars' | 'premium' | 'gifts';
  /** Atributsiya uchun manba identifikatori. */
  source: string;
  /** Ikkinchi darajali havola (masalan, narxlarga). */
  secondary?: { href: string; label: string };
}

const { locale, product, source, secondary } = Astro.props;
const tr = t(locale);

const label = {
  stars: tr('cta.buyStars'),
  premium: tr('cta.buyPremium'),
  gifts: tr('cta.sendGift'),
}[product];

// Stars va Premium uchun foydalanuvchiga ikkinchi sotib olish yo'lini ham
// ko'rsatamiz. StarsJoy asosiy CTA bo'lib qoladi, Uzgets — muqobil variant.
const alternative = sellersOf(product).find((p) => p.id === 'uzgets' && p.bot);
const optionsTitle = {
  uz: 'Xarid variantlari',
  ru: 'Варианты покупки',
  en: 'Purchase options',
}[locale];
---

<div class="cta-block">
  <p class="cta-options-title"><strong>{optionsTitle}</strong></p>
  <div class="hero-cta">
    <a
      class="btn btn-primary"
      href={botLink(PRIMARY.bot!, source)}
      target="_blank"
      rel="noopener"
      data-funnel-event
      data-source={source}
      data-product={product}
      data-provider={PRIMARY.id}
    >
      {label}
      <span class="btn-provider">— {PRIMARY.name}</span>
      <span aria-hidden="true">→</span>
    </a>
    {alternative && (
      <a
        class="btn btn-ghost"
        href={botLink(alternative.bot!, `${source}-uzgets`)}
        target="_blank"
        rel="noopener"
        data-funnel-event
        data-source={`${source}-uzgets`}
        data-product={product}
        data-provider={alternative.id}
      >
        {label}
        <span class="btn-provider">— {alternative.name}</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
    {secondary && <a class="link-cta" href={secondary.href}>{secondary.label}</a>}
  </div>
  <p class="cta-note">
    <strong>{PRIMARY.name}</strong> — @{PRIMARY.bot}
    {alternative && <> · <strong>{alternative.name}</strong> — @{alternative.bot}</>}
  </p>
  <p class="cta-disclosure">
    {locale === 'uz' && 'Xarid tanlangan xizmatning Telegram botida amalga oshiriladi.'}
    {locale === 'ru' && 'Покупка оформляется в Telegram-боте выбранного сервиса.'}
    {locale === 'en' && 'The purchase is completed in the selected service’s Telegram bot.'}
  </p>
</div>
