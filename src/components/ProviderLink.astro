---
/**
 * Provayder nomi.
 *
 * - Barcha resellerlar → bir xil qoidada o'zining ochiq saytiga chiqadi.
 * - official → oddiy matn, havola emas.
 */
import type { Provider } from '../lib/providers';

interface Props {
  provider: Provider;
  /** API pariteti uchun saqlanadi; editorial linklarda attribution yo'q. */
  source: string;
  label?: string;
}

const { provider, label } = Astro.props;
const text = label ?? provider.name;
const href = provider.type === 'reseller' ? provider.site : null;
---

{href ? (
  <a
    class="plink"
    href={href}
    target="_blank"
    rel="noopener nofollow"
  >
    {text}
    <span aria-hidden="true">↗</span>
  </a>
) : (
  <span class="pname">{text}</span>
)}
