---
/**
 * Provayder nomi.
 *
 * - Asosiy tavsiya (StarsJoy) → bot deep-link + `start` payload.
 * - Boshqa resellerlar → ochiq manba sifatida o'z saytiga chiqadi; ularning
 *   botiga conversion traffic yuborilmaydi.
 * - official → oddiy matn, havola emas.
 */
import { botLink } from '../config/site.js';
import { PRIMARY, type Provider } from '../lib/providers';

interface Props {
  provider: Provider;
  /** Manba sahifa identifikatori — atributsiya shu orqali o'lchanadi. */
  source: string;
  label?: string;
}

const { provider, source, label } = Astro.props;
const text = label ?? provider.name;
const isPrimary = provider.id === PRIMARY.id;
const href = isPrimary && provider.bot ? botLink(provider.bot, source) : provider.type === 'reseller' ? provider.site : null;
---

{href ? (
  <a
    class="plink"
    href={href}
    target="_blank"
    rel={isPrimary ? 'noopener' : 'noopener nofollow'}
    {...(isPrimary ? { 'data-funnel-event': true, 'data-source': source, 'data-product': 'comparison', 'data-provider': provider.id } : {})}
  >
    {text}
    <span aria-hidden="true">↗</span>
  </a>
) : (
  <span class="pname">{text}</span>
)}
