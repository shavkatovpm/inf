---
import { getCollection } from "astro:content";
import Article from "../../../views/Article.astro";

export async function getStaticPaths() {
  const entries = await getCollection("taqqoslash");
  return entries
    .filter((e) => e.id.startsWith("en/"))
    .map((e) => ({
      params: { slug: e.id.split("/").slice(1).join("/") },
      props: { entry: e },
    }));
}

const { entry } = Astro.props;
---
<Article locale="en" section="taqqoslash" entry={entry} />
